{
  "manifest_version": "0.1",
  "name": "memoreal-mcp",
  "version": "1.0.2",
  "description": "Official Node.js MCP connector for Memoreal Cloud (https://memoreal.kolivri.com).",
  "author": {
    "name": "Kolivri",
    "url": "https://memoreal.kolivri.com"
  },
  "server": {
    "type": "node",
    "entry_point": "src/server.mjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/src/server.mjs"]
    }
  }
}
