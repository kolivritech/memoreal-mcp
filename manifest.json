{
  "manifest_version": "0.1",
  "name": "@kolivri/memoria-mcp",
  "version": "1.0.0",
  "description": "Official Node.js MCP connector for Memoria Cloud (https://memoria.kolivri.com).",
  "author": {
    "name": "Kolivri Ltd",
    "url": "https://memoria.kolivri.com"
  },
  "server": {
    "type": "node",
    "entry_point": "src/server.mjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/src/server.mjs"]
    }
  }
}
